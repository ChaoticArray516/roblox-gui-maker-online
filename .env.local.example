# Roblox GUI Maker — 环境变量样例（SOP-3H-13）
# 复制为 .env.local 填入真实值；真实 key 禁止入库（.gitignore 已含 .env*）。
# 生产部署时在 Vercel Dashboard → Settings → Environment Variables 填入同名变量。

# ── Site ──
NEXT_PUBLIC_SITE_URL=https://roblox-gui-maker.online

# ── Supabase (SOP-3H-02) ──
# 从 Supabase Dashboard → Project Settings → API 获取
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # 非公开，仅服务端用

# ── OpenRouter (SOP-3F-12 / 3H-08) ──
# 未配置时 /api/ai/generate 回退 Mock 流
OPENROUTER_API_KEY=sk-or-v1-xxx

# ── Creem 支付 (SOP-3H-05/06/11/12) ──
# 从 Creem Dashboard 获取；test key 前缀 creem_test_ 自动走沙箱
CREEM_API_KEY=creem_test_xxx
CREEM_WEBHOOK_SECRET=whsec_xxx
# 产品 ID：在 Creem Dashboard 建好产品后填入
CREEM_PRODUCT_PRO_MONTHLY=prod_xxx
CREEM_PRODUCT_TEMPLATE_FPS_HUD=prod_xxx
CREEM_PRODUCT_TEMPLATE_PET_SHOP=prod_xxx
CREEM_PRODUCT_TEMPLATE_DIALOGUE=prod_xxx

# ── Analytics（可选，SOP-3B-25）──
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
